{
	// LP1（Excel自動化LP）の Cloudflare Workers デプロイ設定（正本: memory/project-cloudflare.md）
	// 公開は deploy-cf.ps1 経由のみ＝dist/ に公開ファイルだけ転写してからデプロイする。
	// リポ直下を assets.directory にするのは禁止（gitignore済みの内部ファイルが同居しとるため）。
	"name": "lp-excel-automation",
	"compatibility_date": "2026-08-16",
	// 🔴 バージョンごとの Preview URL を出さん（2026-08-25 段階②）
	//   既定は有効＝<hash>-<name>.workers.dev が生えて、本番と同じ中身が別URLで検索に拾われうる。
	//   LP1とPFサイトは noindex を外した本物の面やから、増える口は先に閉じる。
	"preview_urls": false,
	"assets": {
		"directory": "./dist"
	}
}
